    {
      "id": "step-away",
      "group": "Routines",
      "name": "Step away",
      "description": "Pause music, mute and lock the PC",
      "key": {
        "key": "Pause"
      },
      "macro": {
        "name": "Step away",
        "steps": [
          {
            "type": "media",
            "action": "playPause"
          },
          {
            "type": "media",
            "action": "mute"
          },
          {
            "type": "delay",
            "ms": 200
          },
          {
            "type": "system",
            "action": "lockScreen"
          }
        ]
      }
    },
    {
      "id": "focus",
      "group": "Routines",
      "name": "Focus mode",
      "description": "Mute, minimise everything and open a note",
      "macro": {
        "name": "Focus mode",
        "steps": [
          {
            "type": "media",
            "action": "mute"
          },
          {
            "type": "keys",
            "keys": {
              "key": "M",
              "win": true
            }
          },
          {
            "type": "delay",
            "ms": 300
          },
          {
            "type": "system",
            "action": "notepad"
          }
        ]
      }
    },
    {
      "id": "quick-note",
      "group": "Routines",
      "name": "Quick dated note",
      "description": "Open Notepad and start a note with the date and time",
      "macro": {
        "name": "Quick note",
        "steps": [
          {
            "type": "system",
            "action": "notepad"
          },
          {
            "type": "delay",
            "ms": 800
          },
          {
            "type": "dateTime",
            "format": "yyyy-MM-dd HH:mm"
          },
          {
            "type": "keys",
            "keys": {
              "key": "Enter"
            }
          }
        ]
      }
    },
    {
      "id": "start-day",
      "group": "Routines",
      "name": "Start my day",
      "description": "Open your apps and sites one after another",
      "macro": {
        "name": "Start my day",
        "steps": [
          {
            "type": "system",
            "action": "fileExplorer"
          },
          {
            "type": "delay",
            "ms": 500
          },
          {
            "type": "url",
            "url": "https://example.com"
          },
          {
            "type": "delay",
            "ms": 500
          },
          {
            "type": "launch",
            "path": "notepad.exe",
            "args": ""
          }
        ]
      },
      "personalize": "Adjust the apps and sites in Macro Builder afterwards"
    },
    {
      "id": "end-day",
      "group": "Routines",
      "name": "End of day",
      "description": "Pause music, show the desktop and lock",
      "macro": {
        "name": "End of day",
        "steps": [
          {
            "type": "media",
            "action": "playPause"
          },
          {
            "type": "system",
            "action": "showDesktop"
          },
          {
            "type": "delay",
            "ms": 300
          },
          {
            "type": "system",
            "action": "lockScreen"
          }
        ]
      }
    },
